# Copy this file to .env and add your key locally. Never put it in frontend code.
LLM_PROVIDER=fireworks
FIREWORKS_API_KEY=your-api-key-here
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# Defaults to knowledge/mock-saas.md if present, otherwise the committed example.
# Optional custom file: relative to the project root, or an absolute path.
# knowledge/local/ is ignored by Git.
# SAAS_KNOWLEDGE_FILE=knowledge/local/my-saas.md

# Display name and optional server-owned communication rules (never retrieved).
SAAS_NAME=SaaS demo
# SAAS_BRAND_FILE=prompts/local/brand.txt

# Ingestion and query embeddings use Fireworks, independently of the chat provider.
RAG_EMBEDDING_MODEL=fireworks/qwen3-embedding-8b
RAG_EMBEDDING_DIMENSIONS=512
# Store the index outside app/static. Default .rag/ is Git-ignored.
RAG_INDEX_FILE=.rag/knowledge.sqlite3

# Keyword search is the measured default for the current small corpus.
# Alternatives: vector, hybrid. No re-ingestion required when changing these.
RAG_SEARCH_MODE=keyword
RAG_CANDIDATES=10
RAG_TOP_K=3
RAG_MAX_PASSAGES=6
RAG_CONTEXT_CHARACTERS=8500
# Experimental extra Fireworks chat calls; disabled after the Step 04 comparison.
RAG_REWRITE=false
RAG_RERANK=false

# To use OpenAI instead, set LLM_PROVIDER=openai and configure these variables.
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-6-astra
